# ---- Build Stage ----
FROM gradle:7.6.0-jdk8 AS build
WORKDIR /app
COPY . .
RUN ./gradlew war --no-daemon

# ---- Run Stage ----
FROM tomcat:7.0.57-jre8
LABEL maintainer="AltoroJ Docker Maintainer"

# Remove default webapps
RUN rm -rf /usr/local/tomcat/webapps/*

# Copy built WAR from build stage
COPY --from=build /app/build/libs/altoromutual.war /usr/local/tomcat/webapps/ROOT.war

EXPOSE 8080
CMD ["catalina.sh", "run"] 